datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum BusinessStatus {
  OPEN
  CLOSED
  HOLIDAY
  TEMPORARILY_CLOSED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum AvailabilityStatus {
  AVAILABLE
  OUT_OF_STOCK
  SEASONAL
}

enum BadgeType {
  NONE
  SIGNATURE
  BEST_SELLER
  NEW
  SEASONAL
  CHEFS_CHOICE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaStatus {
  READY
  PROCESSING
  ERROR
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

// -----------------------------------------------------------------------------
// CORE MODELS
// -----------------------------------------------------------------------------

model Business {
  id             String         @id @default(cuid())
  name           String
  tagline        String
  description    String
  businessStatus BusinessStatus @default(OPEN)

  // Brand Relations
  logoId       String?
  logo         Media?  @relation("BusinessLogo", fields: [logoId], references: [id])
  favicon      String?
  coverImageId String?
  coverImage   Media?  @relation("BusinessCover", fields: [coverImageId], references: [id])

  // Contact
  phone    String
  whatsapp String
  email    String
  website  String

  // Address
  street        String
  city          String
  state         String
  country       String
  postalCode    String
  googleMapsUrl String
  latitude      Float?
  longitude     Float?

  // JSON Hours (to accommodate flexible structure)
  hours Json

  // Social
  instagram String?
  facebook  String?
  youtube   String?
  x         String?
  threads   String?
  linkedin  String?

  // SEO
  seoTitle       String?
  seoDescription String?
  keywords       String?

  // Online Ordering Prep
  deliveryAvailable Boolean @default(false)
  takeawayAvailable Boolean @default(true)
  dineInAvailable   Boolean @default(true)

  // System
  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?
}

model Category {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  coverImageId String?
  coverImage   Media?  @relation("CategoryCover", fields: [coverImageId], references: [id])

  theme           String @default("classic")
  layoutType      String @default("editorial-grid")
  animationPreset String @default("fade-up")
  displayOrder    Int    @default(0)

  isFeatured  Boolean @default(false)
  isVisible   Boolean @default(true)
  accentColor String?

  products   Product[]
  homepageFeaturedIn HomepageFeaturedCategory[]
  homepageSections HomepageSection[]

  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?
}

model Product {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  shortDescription String
  longDescription  String?
  price            Float   @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  imageId String?
  image   Media?                @relation("ProductImage", fields: [imageId], references: [id])
  gallery ProductGalleryImage[]

  badge              BadgeType          @default(NONE)
  isFeatured         Boolean            @default(false)
  isVisible          Boolean            @default(true)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  displayOrder       Int                @default(0)

  // Product Likes
  likes        ProductLike[]
  likeCountRel ProductLikeCount?

  // Signature Collection
  isSignature    Boolean @default(false)
  signatureOrder Int?

  // Online Ordering Prep
  isAvailable     Boolean @default(true)
  preparationTime Int     @default(15) // minutes
  isSeasonal      Boolean @default(false)

  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?
}

model Media {
  id          String    @id @default(cuid())
  publicId    String    @unique
  fileName    String
  displayName String?
  altText     String?
  type        MediaType @default(IMAGE)

  originalUrl  String
  optimizedUrl String?
  thumbnailUrl String?

  width     Int?
  height    Int?
  sizeBytes Int
  format    String?

  secureUrl    String?
  resourceType String?
  version      Int?

  dominantColor String?
  blurHash      String?
  cropMode      String?
  focusPoint    String?

  isUsed Boolean     @default(true)
  status MediaStatus @default(READY)

  // Back relations
  businessLogos        Business[]            @relation("BusinessLogo")
  businessCovers       Business[]            @relation("BusinessCover")
  categoryCovers       Category[]            @relation("CategoryCover")
  productImages        Product[]             @relation("ProductImage")
  homepageImages       Homepage[]            @relation("HomepageImage")
  homepageAboutImages  Homepage[]            @relation("HomepageAboutImage")
  sectionImages        HomepageSection[]     @relation("SectionImage")
  productGalleryImages ProductGalleryImage[]

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  User       User[]
}

// -----------------------------------------------------------------------------
// HOMEPAGE
// -----------------------------------------------------------------------------

model Homepage {
  id String @id @default(cuid())

  heroTitle    String
  heroSubtitle String
  heroImageId  String?
  heroImage    Media?  @relation("HomepageImage", fields: [heroImageId], references: [id])
  heroCtaText  String?
  heroCtaLink  String?

  aboutTitle       String?
  aboutDescription String?
  aboutImageId     String?
  aboutImage       Media?  @relation("HomepageAboutImage", fields: [aboutImageId], references: [id])

  storyTitle       String?
  storyDescription String?

  featuredCategories HomepageFeaturedCategory[]

  sections HomepageSection[]

  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
}

model HomepageFeaturedCategory {
  id           String   @id @default(cuid())
  homepageId   String
  categoryId   String
  displayOrder Int      @default(0)

  homepage Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([homepageId, categoryId])
}

model HomepageSection {
  id         String   @id @default(cuid())
  homepageId String
  homepage   Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)

  type        String // 'BANNER', 'COLLECTION', 'CUSTOM'
  enabled     Boolean @default(true)
  title       String?
  description String?

  imageId String?
  image   Media?  @relation("SectionImage", fields: [imageId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  buttonText      String?
  buttonLink      String?
  backgroundColor String?

  displayOrder Int @default(0)
}

// -----------------------------------------------------------------------------
// AUTH.JS & USERS
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  avatarId      String?
  avatar        Media?    @relation(fields: [avatarId], references: [id])
  phone         String?

  role   UserRole   @default(STAFF)
  status UserStatus @default(ACTIVE)

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// AUDIT
// -----------------------------------------------------------------------------

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String // e.g. "CREATE", "UPDATE", "DELETE"
  entity   String // e.g. "PRODUCT", "CATEGORY"
  entityId String

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  timestamp DateTime @default(now())
}

model ProductGalleryImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId      String
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([productId, mediaId])
}

// -----------------------------------------------------------------------------
// PRODUCT LIKES
// -----------------------------------------------------------------------------

model ProductLike {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  anonymousUserId String
  createdAt       DateTime @default(now())

  @@unique([productId, anonymousUserId])
  @@index([productId])
  @@index([anonymousUserId])
}

model ProductLikeCount {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// WEBSITE VISITS & ANALYTICS
// -----------------------------------------------------------------------------

model WebsiteVisit {
  id         String   @id @default(cuid())
  path       String   @default("/")
  referrer   String?
  visitorId  String
  sessionId  String?
  deviceType String?  // 'desktop', 'mobile', 'tablet'
  deviceName String?  // 'Apple iPhone', 'Windows PC', 'Apple Mac', 'Android Phone', etc.
  browser    String?  // 'Chrome', 'Safari', 'Firefox', 'Edge', etc.
  os         String?  // 'Windows', 'Mac OS', 'iOS', 'Android', 'Linux'
  ipHash     String?
  country    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([path])
  @@index([createdAt, visitorId])
}
