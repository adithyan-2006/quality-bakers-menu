# Database Connection
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"
DIRECT_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Authentication
AUTH_SECRET="generate-a-secure-secret-using-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_URL_INTERNAL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Upload Limits
UPLOAD_MAX_SIZE="5242880" # 5MB in bytes

# Environment
NODE_ENV="development"

# Repository Settings
REPOSITORY_DRIVER="prisma"

# Cross-app ISR revalidation (Admin → Customer)
# Set in apps/admin/.env.local locally, and in the Admin Vercel project's env vars in production.
# CUSTOMER_APP_URL must NOT have a trailing slash.
CUSTOMER_APP_URL="https://your-customer-app.vercel.app"
# Generate with: openssl rand -base64 32
# Must also be set as REVALIDATION_SECRET in the Customer Vercel project.
REVALIDATION_SECRET="generate-a-secure-secret-using-openssl-rand-base64-32"
